# maai configuration — copy to ~/.config/maai/maai.conf
#
# One setting per line. `#` starts a comment. The separator may be a space or a
# colon, so both of these are the same line:
#
#     font_size 12
#     font_size: 12
#
# This is not YAML: no nesting, no lists, no quoting. It is a flat mapping, which is
# all a terminal config needs, and it means existing `key value` theme files load
# unchanged.
#
# Every line below shows the default. An unknown setting or an unparseable value is
# reported on stderr and skipped — a typo never stops the terminal from opening.
#
# The config, the theme file, and the flavour file are all watched: saving any of them
# applies immediately. Two exceptions, both reported when you hit them:
#   - scrollback_lines applies at the next start
#   - a font that fails to load leaves the previous one in place

# ── font and layout ──────────────────────────────────────────────────────────

# Must be monospace. A name fontconfig cannot find is *substituted*, not refused, so
# a typo here would otherwise silently give you a proportional font and overlapping
# text; maai measures the advances and refuses instead.
# font_family FiraCode Nerd Font Ret
# font_size 12

# Left and top only, matching the usual terminal setup.
# padding_x 4
# padding_y 0

# Lines of history kept per window.
# scrollback_lines 10000

# ── behaviour ────────────────────────────────────────────────────────────────

# Feed a finished selection to CLIPBOARD as well as PRIMARY, so Ctrl+Shift+V pastes
# what was just selected. Not the platform default: it means a clipboard manager
# records every mouse selection. Set to `no` for PRIMARY only.
# copy_on_select yes

# Word boundaries for double-click. Includes shell punctuation so double-clicking
# inside a path or a URL grabs the whole thing.
# word_separators  	"'`()[]{}<>|;:,!?*+=&^%$#@\

# On the alternate screen with no mouse tracking, send cursor keys for the wheel.
# This is what makes the wheel work in `less` and `man` (xterm's mode 1007).
# alternate_scroll yes

# The program handed a URL by Ctrl+click or hint mode. One program, no arguments:
# it is passed an argv array, never a shell string, and a value with spaces is
# refused rather than split.
# url_launcher xdg-open

# ── tab bar ──────────────────────────────────────────────────────────────────

# `powerline` draws a separator glyph between tabs, wearing the colour of the tab it
# leaves on the background of the one it enters — which is what makes the edge read as
# a shape rather than a character. `plain` draws flat blocks instead.
#
# Powerline needs the separator glyphs, which live in the Nerd Font private-use range.
# With a font that lacks them the separators come out blank; `plain` is the way out.
#
# `hidden` draws no bar and gives its row back to the grid. Tabs keep working unseen.
# For a scratchpad window, `maai --no-tabs` is the better tool: it hides the bar and
# hands the tab keys back to the child, for that window only, whatever this file says.
#
# tab_bar_style powerline

# angled (), slanted (), round (). Names and glyphs follow the established
# powerline conventions.
# tab_powerline_style slanted

# ── keyboard shortcuts ───────────────────────────────────────────────────────
#
#     key <combination> <action>
#
# Modifiers are `ctrl`, `shift`, `alt`, joined with `+`. The key is an xkb keysym
# name — `c`, `percent`, `Page_Up`, `F5`, `Tab` — the same names used in
# /usr/share/X11/xkb/symbols, so there is one vocabulary rather than two.
#
# Write the combination as it reads; the shifted spellings are undone for you:
#   - `shift+c` matches, without spelling the keysym as `C`
#   - `shift+tab` matches, without knowing xkb calls it `ISO_Left_Tab`
#   - for punctuation, Shift is how the character is *typed* and is ignored — `%` is
#     Shift+ù here and unshifted elsewhere, so `alt+percent` works either way.
#     Letters and digits keep Shift as a real distinction, so `ctrl+c` and
#     `ctrl+shift+c` stay different.
#
# A later line replaces an earlier one, so a `key` here overrides the default. The
# action `none` *unbinds* a combination, handing it back to applications — which is
# what you want for any shortcut a full-screen program needs. Under the CSI u
# keyboard protocol applications can see combinations the legacy encoding could not
# express, so this is the escape hatch when the terminal and an application want the
# same key.
#
# `numrow` is a key name meaning "any key of the number row, by position". On AZERTY
# the unshifted row is & é " ' ( - è _ ç à, so `alt+numrow` is Alt plus one key where
# Alt+1 would need Shift too — and matching by position keeps working on a layout
# where those characters live elsewhere. Browsers bind their tab keys the same way.
#
# Actions: copy, paste, paste_primary, hints, new_window, scroll_page_up,
#          scroll_page_down, scroll_top, scroll_bottom, tab_new, tab_next, tab_prev,
#          tab_goto, tab_move_left, tab_move_right, none
#
# The defaults:
# key ctrl+shift+c copy
# key ctrl+shift+v paste
# key ctrl+shift+u hints
# key alt+percent new_window
# key shift+Page_Up scroll_page_up
# key shift+Page_Down scroll_page_down
# key shift+Home scroll_top
# key shift+End scroll_bottom
# key ctrl+shift+t tab_new
# key ctrl+tab tab_next
# key ctrl+shift+tab tab_prev
# key alt+numrow tab_goto
# key ctrl+shift+Page_Up tab_move_left
# key ctrl+shift+Page_Down tab_move_right
#
# tab_move_left/right slide the current tab along the strip, taking the focus with
# them, and stop at the ends rather than wrapping round. They are the only defaults
# that take a sequence applications can otherwise read (CSI 5;6~ and CSI 6;6~), so if
# something you run wants those keys, free them with `none` and bind the actions
# elsewhere.

# ── theme ────────────────────────────────────────────────────────────────────

# A name or a path.
#
#   theme nightfox              looked up in theme_dir, trying .conf/.yaml/.yml
#   theme: nord.yaml            same, extension included
#   theme ~/themes/solarized    an absolute or ~ path, used as given
#
# Anything containing a `/` or starting with `~` is treated as a path; anything else
# as a name. Leave it unset to follow theme_flavour_file instead.
# theme nightfox

# Where a *named* theme is looked up. Defaults to the directory this machine's
# app-theme switcher already writes into, so its dayfox/nightfox files just work.
# theme_dir ~/.config/maai/themes

# A file holding nothing but a theme name. Used only when `theme` is unset. The
# switcher rewrites it, and maai watches it — so flipping the flavour re-themes
# every open window instantly, including text already on screen.
# theme_flavour_file ~/.config/.app-theme-flavour

# Pull in another file. Relative paths resolve against this file's directory.
# include colors.conf

# ── theme file format ────────────────────────────────────────────────────────
#
# Theme files use the established `key value` colour names, because that is what
# this machine's themes are
# written in. Colours accept #rgb, #rrggbb, #rrrgggbbb, #rrrrggggbbbb and
# rgb:r/g/b. Keys maai has no chrome for (tab bar, borders, bell) are ignored
# quietly rather than reported.
#
#     background            #192330
#     foreground            #cdcecf
#     cursor                #cdcecf
#     cursor_text_color     #192330
#     selection_background  #2b3b51
#     selection_foreground  #cdcecf
#     hint_background       #dbc074      (maai-specific: hint-mode labels)
#     hint_foreground       #192330
#     tab_bar_background      #192330    (the strip behind the tabs; omit it, or
#                                         write `none`, to follow `background`)
#     inactive_tab_background #2b3b51
#     inactive_tab_foreground #738091
#     active_tab_background   #719cd6
#     active_tab_foreground   #131a24
#     color0 ... color255   #rrggbb
